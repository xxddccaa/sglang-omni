FROM lmsysorg/sglang:dev

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/root/.cache/huggingface
ENV MODEL_PATH=/models/s2-pro
ENV CONFIG_PATH=examples/configs/s2pro_tts.yaml
ENV HOST=0.0.0.0
ENV PORT=8000
ENV MODEL_NAME=s2-pro
ENV LOG_LEVEL=info

WORKDIR /workspace/sglang-omni

# install UCX
RUN git clone https://github.com/openucx/ucx.git \
    && cd ucx \
    && git checkout v1.20.x \
    && ./autogen.sh \
    && ./contrib/configure-release-mt  \
    --enable-shared                    \
    --disable-static                   \
    --disable-doxygen-doc              \
    --enable-optimizations             \
    --enable-cma                       \
    --enable-devel-headers             \
    --with-cuda=/usr/local/cuda        \
    --with-verbs                       \
    --with-dm                          \
    --prefix=/usr/local                \
    && make -j \
    && make -j install-strip \
    && ldconfig

# Keep the runtime image self-contained: install build/runtime tools that the
# S2-Pro stack expects, then install the package itself with the s2pro extras.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ffmpeg \
    libsndfile1 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY . /workspace/sglang-omni

# Install the repo as an editable package so console scripts and package data
# are registered correctly inside the image. We invoke the module directly at
# runtime, so startup does not depend on PATH exposing `sgl-omni`.
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -e ".[s2pro]"

COPY docker/entrypoint.s2pro.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
