ARG BASE_IMAGE=kevinchina/deeplearning:swift-v3.12.1-dev-13

FROM ghcr.io/astral-sh/uv:0.9.22 AS uv-bin

FROM ${BASE_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    curl \
    ca-certificates \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv-bin /uv /uvx /usr/local/bin/

WORKDIR /app

COPY . /app

RUN uv venv /opt/venv --python python3 \
    && uv pip install --python /opt/venv/bin/python -e ".[s2pro]"

RUN chmod +x /app/docker/entrypoint-s2pro.sh

EXPOSE 18000

ENTRYPOINT ["/app/docker/entrypoint-s2pro.sh"]
